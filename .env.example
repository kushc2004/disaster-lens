# Extracted official BRIGHT root (must contain pre-event, post-event, target).
DISASTERLENS_BRIGHT_ROOT=data/raw/bright

# Resumable Kaggle notebook controls.
DISASTERLENS_FROM_MILESTONE=M3
DISASTERLENS_THROUGH_MILESTONE=M4
DISASTERLENS_TEST_EVENT=
DISASTERLENS_M3_EPOCHS=60
DISASTERLENS_M4_EPOCHS=60
DISASTERLENS_MONTE_CARLO_SIMULATIONS=500
DISASTERLENS_SENSITIVITY_SAMPLES=1000

# Required only when running M6 and later.
DISASTERLENS_POPULATION_YEAR=
DISASTERLENS_POPULATION_SOURCE=WorldPop
DISASTERLENS_POPULATION_VERSION=
DISASTERLENS_POPULATION_LICENSE=
DISASTERLENS_POPULATION_DOWNLOAD_DATE=
DISASTERLENS_WORLDPOP=
DISASTERLENS_WORLDPOP_SOURCE=
DISASTERLENS_WORLDPOP_URL=
DISASTERLENS_ROADS=
DISASTERLENS_FACILITIES=
DISASTERLENS_ROADS_SOURCE=
DISASTERLENS_FACILITIES_SOURCE=
DISASTERLENS_OSM_BBOX=
DISASTERLENS_OVERPASS_URL=
